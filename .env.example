# Copy to .env (git-ignored) and fill in.
# Same Google OAuth client ID as the backend. Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_API_URL=http://localhost:8081

# Shown in the privacy policy (a controller must be reachable). Set both before going live.
VITE_CONTACT_EMAIL=privacy@your-domain.eu
VITE_COMPANY_ADDRESS=Street and number, City, County, Romania
