# Copy to .env (git-ignored) and fill in.
# Same Google OAuth client ID as the backend. Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_API_URL=http://localhost:8081

# Shown in the privacy policy (a controller must be reachable). Set both before going live.
VITE_CONTACT_EMAIL=privacy@your-domain.eu
VITE_COMPANY_ADDRESS=Street and number, City, County, Romania

# Shown in the legal footer and the terms. Add them as soon as you have them.
VITE_CONTACT_PHONE=+40 700 000 000

# Google Analytics 4 measurement ID (public). Production builds use G-2CMX4RVC8T when this is unset; set it empty to switch statistics off.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
